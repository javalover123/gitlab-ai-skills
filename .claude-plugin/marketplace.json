{
  "name": "gitlab-skills",
  "owner": {
    "name": "GitLab"
  },
  "metadata": {
    "description": "Reusable AI agent skills for GitLab workflows"
  },
  "plugins": [
    {
      "name": "gitlab-clickhouse",
      "source": "./.claude-plugin/plugins/gitlab-clickhouse"
    },
    {
      "name": "glab",
      "source": "./.claude-plugin/plugins/glab"
    },
    {
      "name": "gitlab-psql",
      "source": "./.claude-plugin/plugins/gitlab-psql"
    },
    {
      "name": "run-in-tmux-pane",
      "source": "./.claude-plugin/plugins/run-in-tmux-pane"
    },
    {
      "name": "self-service-performance-testing",
      "source": "./.claude-plugin/plugins/self-service-performance-testing"
    },
    {
      "name": "writing-commit-messages",
      "source": {
        "source": "git-subdir",
        "url": "https://gitlab.com/gitlab-org/ai/skills.git",
        "path": "skills/writing-commit-messages"
      },
      "description": "Use when creating git commits, writing commit messages, or when about to run git commit \u2014 enforces structured commit message format with imperative mood, capitalized subjects, 72-char wrapping, and atomic commits",
      "version": "1.0.0",
      "author": {
        "name": "GitLab"
      },
      "license": "MIT"
    }
  ]
}
