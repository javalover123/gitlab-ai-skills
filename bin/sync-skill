#!/usr/bin/env python3
"""Sync SKILL.md frontmatter versions into distributed plugin manifests.

For each distributed skill in:
- .claude-plugin/plugins/<skill>/plugin.json
- .codex-plugin/plugins/<skill>/.codex-plugin/plugin.json
reads the version from SKILL.md and writes it into the manifest.

Usage:
    bin/sync-skill               # Sync all distributed skills and report
    bin/sync-skill --ci          # Check only; exit 1 if any version is out of sync
    bin/sync-skill --debug       # Enable debug logging
"""

import os
import sys

BIN_DIR = os.path.dirname(os.path.realpath(__file__))
REPO_ROOT = os.path.join(BIN_DIR, "..")

sys.path.insert(0, os.path.join(REPO_ROOT, "scripts"))
from sync_skill import main  # noqa: E402

if __name__ == "__main__":
    main()
