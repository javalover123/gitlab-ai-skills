#!/usr/bin/env python3
"""
pw — context-efficient wrapper around playwright-cli

Reduces agent context usage by:
  - Inlining and filtering snapshot YAML (no separate Read call needed)
  - Stripping "Ran Playwright code" JS blocks
  - Stripping browser session detail from open output  
  - Stripping "Events" section
  - Filtering snapshot noise: empty generics, unnamed imgs, separators,
    listitem/row/cell/table/navigation structural wrappers

Usage: pw [playwright-cli args...]  or  playwright-cli [args...]
  Same syntax as playwright-cli. Always prefer pw for cleaner output.
  Raw playwright-cli is the fallback if pw causes issues.
"""

import os
import re
import subprocess
import sys


def filter_snapshot(content: str) -> str:
    lines = content.split('\n')
    out = []
    for line in lines:
        s = line.strip()
        if not s:
            continue
        # Empty generic wrappers (end with ':' after ref, no inline text)
        if re.match(r'^- generic \[[^\]]*\](\s*\[[^\]]*\])*\s*:\s*$', s):
            continue
        # Separator
        if re.match(r'^- separator', s):
            continue
        # Unnamed img (no accessible name)
        if re.match(r'^- img \[ref=', s):
            continue
        # Structural list/table wrappers — their children (links etc) still show
        if re.match(r'^- listitem \[ref=', s):
            continue
        if re.match(r'^- (row |cell |rowgroup |table )', s):
            continue
        # Bare navigation landmark (no text, its children still show)
        if re.match(r'^- navigation\s*$', s):
            continue
        out.append(line)
    return '\n'.join(out)


def inline_snapshots(text: str) -> str:
    def replace(m):
        path = m.group(1)
        if os.path.exists(path):
            with open(path, encoding="utf-8") as f:
                return filter_snapshot(f.read()).strip()
        return m.group(0)
    return re.sub(r'- \[Snapshot\]\(([^)]+)\)', replace, text)


def clean(raw: str) -> str:
    out = raw
    # Strip Ran Playwright code JS blocks
    out = re.sub(r'### Ran Playwright code\n```js.*?```\n', '', out, flags=re.DOTALL)
    # Strip browser open session detail (pid + type/profile/headed lines + --- separator)
    out = re.sub(
        r'### Browser [^\n]+ opened with pid \d+\.\n(?:- \w[^\n]*\n(?:  [^\n]+\n)*)---\n',
        '', out
    )
    # Strip Events section
    out = re.sub(r'### Events\n(?:- [^\n]+\n)*', '', out)
    # Strip zero console noise
    out = re.sub(r'\n- Console: 0 errors, 0 warnings', '', out)
    # Inline snapshots
    out = inline_snapshots(out)
    # Collapse blank lines
    out = re.sub(r'\n{3,}', '\n\n', out)
    return out.strip()


def run(args):
    # Exclude ~/bin from PATH to avoid recursive wrapper calls
    env = os.environ.copy()
    bin_dir = os.path.realpath(os.path.expanduser('~/bin'))
    env['PATH'] = ':'.join(
        p for p in env['PATH'].split(':')
        if os.path.realpath(p) != bin_dir
    )
    try:
        r = subprocess.run(['playwright-cli'] + args, capture_output=True, text=True, env=env)
        return r.stdout + r.stderr
    except FileNotFoundError:
        r = subprocess.run(['npx', 'playwright-cli'] + args, capture_output=True, text=True, env=env)
        return r.stdout + r.stderr


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help'):
        print(__doc__)
        sys.exit(0)
    try:
        raw = run(args)
        result = clean(raw)
        if result:
            print(result)
    except (OSError, FileNotFoundError):
        env = os.environ.copy()
        bin_dir = os.path.realpath(os.path.expanduser('~/bin'))
        env['PATH'] = ':'.join(p for p in env['PATH'].split(':') if os.path.realpath(p) != bin_dir)
        print("pw: filtering failed, falling back to raw playwright-cli", file=sys.stderr)
        os.execvpe('playwright-cli', ['playwright-cli'] + args, env)


if __name__ == '__main__':
    main()
