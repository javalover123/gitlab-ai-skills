#!/usr/bin/env python3
"""
playwright-cli wrapper - applies context-efficient filtering automatically.
Calls the real playwright-cli binary with output filtering via the pw script.
"""
import sys, os, subprocess

# Find the real playwright-cli (not this wrapper)
skill_pw = os.path.expanduser('~/.agents/skills/playwright-cli/scripts/pw')

if os.path.exists(skill_pw):
    os.execv(skill_pw, [skill_pw] + sys.argv[1:])
else:
    # Fallback: find real playwright-cli (skip this wrapper)
    import shutil
    real = None
    for d in os.environ.get('PATH', '').split(':'):
        if d == os.path.dirname(os.path.abspath(__file__)):
            continue
        candidate = os.path.join(d, 'playwright-cli')
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            real = candidate
            break
    if real:
        os.execv(real, [real] + sys.argv[1:])
    else:
        print("playwright-cli not found", file=sys.stderr)
        sys.exit(1)
